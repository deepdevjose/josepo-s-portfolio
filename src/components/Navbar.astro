---
import Icon from "./Icon.astro";
import {
  languageOptions,
  localizedPath,
  localePaths,
  type Locale,
  type NavItem
} from "../data/site";

interface Props {
  brand: string;
  links: NavItem[];
  connect: string;
  languageLabel: string;
  openMenuLabel: string;
  closeMenuLabel: string;
  locale: Locale;
}

const {
  brand,
  links,
  connect,
  languageLabel,
  openMenuLabel,
  closeMenuLabel,
  locale
} = Astro.props;
const resolveHref = (href: string) => href.startsWith("#") ? `${localizedPath(locale)}${href}` : href;
const cvPaths: Record<Locale, string> = {
  en: "/cv/jose-manuel-cortes-cv(english).pdf",
  es: "/cv/jose-manuel-cortes-cv(spanish).pdf",
  "zh-cn": "/cv/jose-manuel-cortes-cv(cn).pdf"
};
const mobileLinks = [
  ...links,
  { label: "GitHub", href: "https://github.com/deepdevjose" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/deepdevjose/" },
  { label: locale === "es" ? "Descargar CV" : locale === "zh-cn" ? "下载简历" : "Download CV", href: cvPaths[locale] },
  { label: connect, href: "#contact" }
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-black/10 bg-white">
  <nav class="mx-auto max-w-site px-5 lg:px-8" aria-label="Primary navigation">
    <div class="flex h-16 items-center justify-between gap-4">
      <a href={localizedPath(locale)} class="site-brand flex items-center font-semibold text-ink">
        <span>{brand}</span>
      </a>

      <div class="hidden items-center gap-7 md:flex">
        {links.map((item) => (
          <a class="text-sm font-medium text-ink/78 transition hover:text-ink" href={resolveHref(item.href)}>
            {item.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-4 sm:gap-5">
        <div class="hidden h-9 items-center gap-3 sm:flex md:mr-1" aria-label={languageLabel}>
          {languageOptions.map((option) => (
            <a
              href={localePaths[option.locale]}
              class:list={[
                "relative inline-flex h-8 items-center px-1 text-xs leading-none transition",
                option.locale === locale ? "font-bold text-ink after:absolute after:bottom-0 after:left-1/2 after:h-1 after:w-1 after:-translate-x-1/2 after:rounded-full after:bg-accent" : "font-semibold text-muted hover:text-ink"
              ]}
              aria-current={option.locale === locale ? "page" : undefined}
              title={option.name}
            >
              {option.label}
            </a>
          ))}
        </div>

        <a
          href={`${localizedPath(locale)}#contact`}
          class="group hidden items-center gap-2 rounded-lg bg-ink px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-black md:inline-flex"
        >
          <span>{connect}</span>
          <Icon name="arrow-up-right" class="h-4 w-4 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
        </a>

        <button
          id="mobile-menu-button"
          aria-controls="mobile-menu"
          aria-expanded="false"
          class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-black/5 bg-white/90 p-0 text-ink md:hidden"
          aria-label={openMenuLabel}
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
        </button>
      </div>
    </div>

    <div id="mobile-menu" class="hidden fixed inset-0 z-[80] h-dvh w-screen flex-col overflow-y-auto bg-paper p-5 md:hidden" aria-hidden="true">
      <div class="flex items-center justify-between">
        <a href={localizedPath(locale)} class="text-xl font-semibold">{brand}</a>
        <button id="mobile-menu-close" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-black/5 bg-white p-0 text-ink" aria-label={closeMenuLabel}>
          <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>

      <nav class="mt-8 flex flex-col gap-3" aria-label="Mobile primary">
        {mobileLinks.map((item) => (
          <a
            href={resolveHref(item.href)}
            target={item.href.startsWith("http") ? "_blank" : undefined}
            rel={item.href.startsWith("http") ? "noreferrer" : undefined}
            download={item.href.endsWith(".pdf") ? true : undefined}
            class:list={[
              "flex min-h-11 items-center justify-between rounded-lg px-4 py-3 text-lg font-semibold",
              item.href === "#contact" ? "bg-ink text-white shadow-sm" : "text-ink hover:bg-black/4"
            ]}
          >
            <span>{item.label}</span>
            <Icon
              name={item.href.endsWith(".pdf") ? "download" : item.href.startsWith("http") ? "arrow-up-right" : "arrow-down"}
              class:list={["h-4 w-4", !item.href.startsWith("http") && !item.href.endsWith(".pdf") ? "-rotate-90" : ""]}
            />
          </a>
        ))}

        <div class="mt-4 border-t border-black/6 pt-4">
          <p class="mb-2 text-sm text-muted">{languageLabel}</p>
          <div class="flex gap-2">
            {languageOptions.map((option) => (
              <a
                href={localePaths[option.locale]}
                class:list={[
                  "rounded-md px-3 py-2 text-sm font-semibold",
                  option.locale === locale ? "bg-ink text-white" : "text-muted hover:bg-black/4"
                ]}
                aria-current={option.locale === locale ? "page" : undefined}
              >
                {option.label}
              </a>
            ))}
          </div>
        </div>
      </nav>
    </div>

    <script>
      (function(){
        const btn = document.getElementById('mobile-menu-button');
        const close = document.getElementById('mobile-menu-close');
        const menu = document.getElementById('mobile-menu');
        if(!btn || !menu) return;
        const mobileMenu = menu!;
        const mobileMenuButton = btn!;
        function open(){
          mobileMenu.classList.remove('hidden');
          mobileMenu.setAttribute('aria-hidden','false');
          mobileMenuButton.setAttribute('aria-expanded','true');
          document.body.style.overflow='hidden';
        }
        function closeMenu(){
          mobileMenu.classList.add('hidden');
          mobileMenu.setAttribute('aria-hidden','true');
          mobileMenuButton.setAttribute('aria-expanded','false');
          document.body.style.overflow='';
        }
        mobileMenuButton.addEventListener('click', open);
        if(close) close.addEventListener('click', closeMenu);
        mobileMenu.addEventListener('click', (e)=>{ if(e.target===mobileMenu) closeMenu(); });
        mobileMenu.querySelectorAll('a').forEach((link)=>link.addEventListener('click', closeMenu));
      })();
    </script>
  </nav>
</header>
