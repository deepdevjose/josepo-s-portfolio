---
import Icon from "./Icon.astro";
import SectionHeader from "./SectionHeader.astro";
import type { BlogPost } from "../data/blog";

interface Props {
  eyebrow: string;
  viewAll: string;
  viewAllHref: string;
  readLabel: string;
  featuredLabel: string;
  posts: BlogPost[];
}

const { eyebrow, viewAll, viewAllHref, readLabel, featuredLabel, posts } = Astro.props;
const visiblePosts = posts.slice(0, 3);
---

<section id="blog" class="bg-paper py-12 sm:py-16">
  <div class="mx-auto max-w-site px-5 lg:px-8">
    <SectionHeader eyebrow={eyebrow} action={viewAll} href={viewAllHref} />

    <div class="grid gap-4 lg:grid-cols-3">
      {visiblePosts.map((post) => (
        <a
          href={`${viewAllHref}${post.slug}/`}
          class="surface-card group flex min-h-[260px] flex-col rounded-lg border border-black/10 bg-white p-5 transition duration-300 hover:-translate-y-1 hover:border-black/20 hover:shadow-soft"
        >
          <div class="flex items-center justify-between gap-3">
            <p class="mono-label text-[0.68rem] font-semibold uppercase text-accent">{post.category}</p>
            {post.featured && (
              <span class="rounded-full border border-black/10 px-2 py-1 text-[0.68rem] font-semibold uppercase text-muted">
                {featuredLabel}
              </span>
            )}
          </div>
          <div class="mt-4 overflow-hidden rounded-md border border-black/10 bg-paper">
            <img src={post.coverImage} alt="" class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-[1.02]" loading="lazy" />
          </div>
          <h3 class="mt-4 text-lg font-semibold leading-6 text-ink">{post.title}</h3>
          <p class="mt-3 text-sm leading-6 text-muted">{post.description}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {post.tags.slice(0, 3).map((tag) => (
              <span class="rounded-md bg-black/[0.04] px-2 py-1 text-xs font-medium text-muted">{tag}</span>
            ))}
          </div>
          <div class="mt-auto flex items-center justify-between gap-4 pt-6">
            <p class="text-xs font-medium text-muted">{post.date} · {post.readTime}</p>
            <span class="inline-flex items-center gap-2 text-sm font-semibold text-ink">
              {readLabel}
              <Icon name="arrow-up-right" class="h-4 w-4 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
