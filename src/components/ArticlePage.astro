---
import Footer from "./Footer.astro";
import Icon from "./Icon.astro";
import Navbar from "./Navbar.astro";
import { blogArticles, getBlogArticleBySlug } from "../data/blogArticles";
import { localizedPath, pageText, siteText, type Locale } from "../data/site";
import Layout from "../layouts/Layout.astro";

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const copy = siteText[locale];
const page = pageText[locale];
const article = getBlogArticleBySlug(slug);

if (!article) {
  throw new Error(`Unknown blog article: ${slug}`);
}

const escapeHtml = (value: string) =>
  value
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");

const inline = (value: string) =>
  escapeHtml(value)
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noreferrer">$1</a>');

function renderMarkdown(markdown: string) {
  const lines = markdown.trim().split(/\r?\n/);
  const html: string[] = [];
  let paragraph: string[] = [];
  let list: string[] = [];

  const flushParagraph = () => {
    if (paragraph.length === 0) return;
    html.push(`<p>${inline(paragraph.join(" "))}</p>`);
    paragraph = [];
  };

  const flushList = () => {
    if (list.length === 0) return;
    html.push(`<ul>${list.map((item) => `<li>${inline(item)}</li>`).join("")}</ul>`);
    list = [];
  };

  for (const rawLine of lines) {
    const line = rawLine.trim();

    if (!line) {
      flushParagraph();
      flushList();
      continue;
    }

    const image = line.match(/^!\[([^\]]*)\]\(([^)]+)\)$/);
    if (image) {
      flushParagraph();
      flushList();
      html.push(`<figure><img src="${escapeHtml(image[2])}" alt="${escapeHtml(image[1])}" loading="lazy" /><figcaption>${inline(image[1])}</figcaption></figure>`);
      continue;
    }

    if (line.startsWith("### ")) {
      flushParagraph();
      flushList();
      html.push(`<h3>${inline(line.slice(4))}</h3>`);
      continue;
    }

    if (line.startsWith("## ")) {
      flushParagraph();
      flushList();
      html.push(`<h2>${inline(line.slice(3))}</h2>`);
      continue;
    }

    if (line.startsWith("- ")) {
      flushParagraph();
      list.push(line.slice(2));
      continue;
    }

    paragraph.push(line);
  }

  flushParagraph();
  flushList();
  return html.join("");
}

const articleHtml = renderMarkdown(article.content);
const related = blogArticles.filter((item) => item.slug !== article.slug).slice(0, 3);
---

<Layout locale={locale} lang={copy.langAttr} title={`${article.title} - ${copy.metaTitle}`} description={article.description}>
  <Navbar {...copy.nav} locale={locale} coffeeSupport={copy.hero.coffeeSupport} />
  <main id="top" class="min-h-screen bg-paper pt-24">
    <article class="mx-auto max-w-[980px] px-5 pb-16 pt-8 lg:px-8">
      <a href={localizedPath(locale, "blog/")} class="inline-flex items-center gap-2 text-sm font-semibold text-muted transition hover:text-ink">
        <Icon name="arrow-down" class="h-4 w-4 rotate-90" />
        {page.blog.title}
      </a>

      <header class="mt-10">
        <p class="mono-label text-xs font-semibold uppercase text-accent">{article.category}</p>
        <h1 class="mt-4 text-4xl font-bold leading-tight text-ink sm:text-6xl">{article.title}</h1>
        <p class="mt-5 max-w-3xl text-base leading-7 text-muted sm:text-lg">{article.description}</p>
        <div class="mt-6 flex flex-wrap items-center gap-3 text-sm font-medium text-muted">
          <span>{article.date}</span>
          <span class="h-1 w-1 rounded-full bg-muted/60"></span>
          <span>{article.reading_time}</span>
        </div>
        <div class="mt-6 flex flex-wrap gap-2">
          {article.tags.map((tag) => (
            <span class="rounded-md bg-black/[0.05] px-2.5 py-1.5 text-xs font-semibold text-muted">{tag}</span>
          ))}
        </div>
        {article.downloadUrl && (
          <a href={article.downloadUrl} class="mt-6 inline-flex items-center gap-2 rounded-lg border border-black/10 bg-white px-4 py-2.5 text-sm font-semibold text-ink transition hover:bg-black/5">
            PDF
            <Icon name="download" class="h-4 w-4" />
          </a>
        )}
      </header>

      <div class="mt-8 overflow-hidden rounded-lg border border-black/10 bg-white shadow-soft">
        <img src={article.cover_image} alt={article.title} class="aspect-[16/8] w-full object-cover" loading="eager" />
      </div>

      <div class="article-body mt-10 rounded-lg border border-black/10 bg-white px-5 py-7 sm:px-8 sm:py-10" set:html={articleHtml} />

      <aside class="mt-10">
        <p class="mono-label text-xs font-semibold uppercase text-accent">{page.blog.viewAll}</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          {related.map((item) => (
            <a href={localizedPath(locale, `blog/${item.slug}/`)} class="surface-card group rounded-lg border border-black/10 bg-white p-4 transition hover:-translate-y-1 hover:border-black/20 hover:shadow-soft">
              <p class="mono-label text-[0.65rem] font-semibold uppercase text-accent">{item.category}</p>
              <h2 class="mt-3 text-sm font-semibold leading-5 text-ink">{item.title}</h2>
              <span class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-muted group-hover:text-ink">
                {page.blog.read}
                <Icon name="arrow-up-right" class="h-4 w-4" />
              </span>
            </a>
          ))}
        </div>
      </aside>
    </article>
  </main>
  <Footer {...copy.footer} locale={locale} coffeeSupport={copy.hero.coffeeSupport} />
</Layout>
