---
import Footer from "./Footer.astro";
import Icon from "./Icon.astro";
import Navbar from "./Navbar.astro";
import { publications } from "../data/publications";
import { blogPosts } from "../data/blog";
import { localizedPath, pageText, siteText, type Locale } from "../data/site";
import Layout from "../layouts/Layout.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = siteText[locale];
const page = pageText[locale];
const title = `${page.publications.eyebrow} - ${copy.metaTitle}`;
---

<Layout locale={locale} lang={copy.langAttr} title={title} description={page.publications.description}>
  <Navbar {...copy.nav} locale={locale} />
  <main id="top" class="min-h-screen bg-paper pt-24">
    <section class="mx-auto max-w-site px-5 pb-10 pt-8 lg:px-8">
      <a href={localizedPath(locale)} class="inline-flex items-center gap-2 text-sm font-semibold text-muted transition hover:text-ink">
        <Icon name="arrow-down" class="h-4 w-4 rotate-90" />
        {page.backHome}
      </a>
      <p class="mono-label mt-10 text-xs font-semibold uppercase text-accent">{page.publications.eyebrow}</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight text-ink sm:text-6xl">{page.publications.title}</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted sm:text-lg">{page.publications.description}</p>
    </section>

    <section class="mx-auto grid max-w-site gap-6 px-5 pb-16 lg:grid-cols-[0.85fr_1.15fr] lg:px-8">
      <div class="rounded-lg border border-black/10 bg-white p-5">
        <p class="mono-label text-[0.68rem] font-semibold uppercase text-accent">{copy.publications.eyebrow}</p>
        <div class="mt-4 divide-y divide-black/10">
          {publications[locale].map((item) => (
            <a href={item.href} target="_blank" rel="noreferrer" class="group grid grid-cols-[92px_minmax(0,1fr)_20px] gap-4 py-4">
              <time class="text-xs font-medium uppercase text-muted">{item.date}</time>
              <h2 class="text-sm font-medium leading-6 text-ink">{item.title}</h2>
              <Icon name="arrow-up-right" class="mt-1 h-4 w-4 text-muted transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-ink" />
            </a>
          ))}
        </div>
      </div>

      <div class="grid gap-4">
        {blogPosts[locale].map((post) => (
          <a href={localizedPath(locale, `blog/${post.slug}/`)} class="surface-card group rounded-lg border border-black/10 bg-white p-5 transition hover:-translate-y-1 hover:border-black/20 hover:shadow-soft">
            <p class="mono-label text-[0.68rem] font-semibold uppercase text-accent">{post.category}</p>
            <div class="mt-4 overflow-hidden rounded-md border border-black/10 bg-paper">
              <img src={post.coverImage} alt="" class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-[1.02]" loading="lazy" />
            </div>
            <h2 class="mt-3 text-lg font-semibold leading-6 text-ink">{post.title}</h2>
            <p class="mt-2 text-sm leading-6 text-muted">{post.description}</p>
            <div class="mt-4 flex items-center justify-between gap-4">
              <p class="text-xs font-medium text-muted">{post.date} · {post.readTime}</p>
              <span class="inline-flex items-center gap-2 text-sm font-semibold text-ink">
                {page.blog.read}
                <Icon name="arrow-up-right" class="h-4 w-4 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer {...copy.footer} locale={locale} />
</Layout>
