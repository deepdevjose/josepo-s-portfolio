---
import type { CoffeeSupport } from "../data/site";

interface Props extends CoffeeSupport {
  titleId?: string;
}

const {
  modalTitle,
  modalDescription,
  buyCoffeeLabel,
  bankTitle,
  nameLabel,
  clabeLabel,
  copyLabel,
  copiedLabel,
  closeLabel,
  titleId = "support-modal-title"
} = Astro.props;

const href = "https://buymeacoffee.com/deepdevjose";
const accountName = "José Manuel Cortés Cerón";
const clabe = "012180015773176591";
---

<div class="support-modal pointer-events-auto" data-support-modal hidden>
  <div class="support-modal__overlay" data-support-close></div>
  <section
    class="support-modal__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby={titleId}
    tabindex="-1"
    data-support-panel
  >
    <button type="button" class="support-modal__close" aria-label={closeLabel} data-support-close>
      <span aria-hidden="true">×</span>
    </button>

    <div class="support-modal__header">
      <p class="support-modal__eyebrow">DEEPDEVJOSE</p>
      <h2 id={titleId}>{modalTitle}</h2>
      <p>{modalDescription}</p>
    </div>

    <a class="support-modal__primary" href={href} target="_blank" rel="noopener noreferrer">
      <span>{buyCoffeeLabel}</span>
    </a>

    <div class="support-modal__divider" aria-hidden="true"></div>

    <div class="support-modal__bank">
      <h3>{bankTitle}</h3>
      <dl>
        <div>
          <dt>{nameLabel}</dt>
          <dd>{accountName}</dd>
        </div>
        <div>
          <dt>{clabeLabel}</dt>
          <dd>{clabe}</dd>
        </div>
      </dl>
      <button
        type="button"
        class="support-modal__copy"
        data-support-copy
        data-copy-value={clabe}
        data-copy-label={copyLabel}
        data-copied-label={copiedLabel}
      >
        {copyLabel}
      </button>
    </div>
  </section>
</div>

<style>
  .support-modal[hidden] {
    display: none;
  }

  :global(html.support-modal-open),
  :global(html.support-modal-open body) {
    overflow: hidden;
  }

  .support-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    min-height: 100dvh;
    padding: 1rem;
  }

  .support-modal__overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 22%, rgba(44, 60, 93, 0.1), transparent 34%),
      rgba(0, 0, 0, 0.18);
    opacity: 0;
    transition: opacity 200ms ease;
  }

  @supports (backdrop-filter: blur(12px)) {
    .support-modal__overlay {
      backdrop-filter: blur(12px);
    }
  }

  .support-modal.is-open .support-modal__overlay {
    opacity: 1;
  }

  .support-modal__panel {
    position: relative;
    z-index: 1;
    width: min(calc(100vw - 2rem), 29rem);
    max-height: min(88dvh, 42rem);
    overflow-y: auto;
    border: 1px solid rgba(255, 255, 255, 0.66);
    border-radius: 1.6rem;
    background: rgba(250, 249, 246, 0.94);
    box-shadow:
      0 34px 90px rgba(5, 5, 5, 0.24),
      0 0 0 1px rgba(5, 5, 5, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.88);
    padding: 1.35rem;
    opacity: 0;
    transform: translateY(8px) scale(0.98);
    transition: opacity 220ms ease, transform 220ms ease;
  }

  @supports (backdrop-filter: blur(18px)) {
    .support-modal__panel {
      backdrop-filter: blur(18px);
      background: rgba(250, 249, 246, 0.88);
    }
  }

  .support-modal.is-open .support-modal__panel {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .support-modal__close {
    position: absolute;
    right: 0.9rem;
    top: 0.9rem;
    display: inline-flex;
    height: 2.35rem;
    width: 2.35rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(5, 5, 5, 0.08);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.64);
    color: #15171a;
    cursor: pointer;
    font-size: 1.45rem;
    line-height: 1;
    transition: background 180ms ease, transform 180ms ease;
  }

  .support-modal__close:hover,
  .support-modal__close:focus-visible {
    background: #ffffff;
    transform: translateY(-1px);
  }

  .support-modal__header {
    padding-right: 2.75rem;
  }

  .support-modal__eyebrow {
    color: rgba(21, 23, 26, 0.55);
    font-family: ui-monospace, "SFMono-Regular", "IBM Plex Mono", "JetBrains Mono", Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .support-modal__header h2 {
    margin-top: 0.7rem;
    color: #15171a;
    font-size: clamp(1.65rem, 6vw, 2.35rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.04;
  }

  .support-modal__header p {
    margin-top: 0.85rem;
    color: rgba(21, 23, 26, 0.68);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .support-modal__primary,
  .support-modal__copy {
    display: inline-flex;
    min-height: 2.9rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    cursor: pointer;
    font-size: 0.92rem;
    font-weight: 750;
    text-decoration: none;
    transition: background 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .support-modal__primary {
    width: 100%;
    margin-top: 1.35rem;
    background: #15171a;
    box-shadow: 0 16px 34px rgba(5, 5, 5, 0.16);
    color: #ffffff;
  }

  .support-modal__primary:hover,
  .support-modal__primary:focus-visible {
    background: #050505;
    transform: translateY(-1px);
  }

  .support-modal__primary:active,
  .support-modal__copy:active,
  .support-modal__close:active {
    transform: translateY(0) scale(0.99);
  }

  .support-modal__divider {
    height: 1px;
    margin: 1.25rem 0;
    background: linear-gradient(90deg, transparent, rgba(5, 5, 5, 0.12), transparent);
  }

  .support-modal__bank h3 {
    color: #15171a;
    font-size: 1rem;
    font-weight: 750;
  }

  .support-modal__bank dl {
    display: grid;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .support-modal__bank div {
    border: 1px solid rgba(5, 5, 5, 0.08);
    border-radius: 0.8rem;
    background: rgba(247, 247, 245, 0.68);
    padding: 0.8rem 0.9rem;
  }

  .support-modal__bank dt {
    color: rgba(21, 23, 26, 0.48);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .support-modal__bank dd {
    margin-top: 0.35rem;
    color: #15171a;
    font-size: 0.98rem;
    font-weight: 650;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .support-modal__copy {
    width: 100%;
    margin-top: 1rem;
    border: 1px solid rgba(44, 60, 93, 0.28);
    background: rgba(44, 60, 93, 0.08);
    color: #15171a;
  }

  .support-modal__copy:hover,
  .support-modal__copy:focus-visible {
    background: rgba(44, 60, 93, 0.13);
    box-shadow: 0 12px 26px rgba(44, 60, 93, 0.12);
    transform: translateY(-1px);
  }

  .support-modal__close:focus-visible,
  .support-modal__primary:focus-visible,
  .support-modal__copy:focus-visible,
  .support-modal__panel:focus-visible {
    outline: 2px solid rgba(44, 60, 93, 0.64);
    outline-offset: 3px;
  }

  @media (min-width: 640px) {
    .support-modal__panel {
      padding: 1.55rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .support-modal__overlay,
    .support-modal__panel,
    .support-modal__close,
    .support-modal__primary,
    .support-modal__copy {
      transition: none;
    }

    .support-modal__panel,
    .support-modal.is-open .support-modal__panel,
    .support-modal__close:hover,
    .support-modal__close:focus-visible,
    .support-modal__primary:hover,
    .support-modal__primary:focus-visible,
    .support-modal__copy:hover,
    .support-modal__copy:focus-visible {
      transform: none;
    }
  }
</style>

<script>
  const focusableSelector = [
    "a[href]",
    "button:not([disabled])",
    "textarea:not([disabled])",
    "input:not([disabled])",
    "select:not([disabled])",
    '[tabindex]:not([tabindex="-1"])'
  ].join(",");

  document.querySelectorAll<HTMLElement>("[data-support-trigger]").forEach((trigger) => {
    const modal = trigger.nextElementSibling as HTMLElement | null;
    const panel = modal?.querySelector<HTMLElement>("[data-support-panel]");
    const copyButton = modal?.querySelector<HTMLButtonElement>("[data-support-copy]");
    let copyResetTimer: number | undefined;
    let closeTimer: number | undefined;

    if (!modal || !panel) return;

    if (modal.parentElement !== document.body) {
      document.body.append(modal);
    }

    const getFocusable = () =>
      Array.from(panel.querySelectorAll<HTMLElement>(focusableSelector)).filter(
        (element) => !element.hasAttribute("disabled") && element.offsetParent !== null
      );

    const closeModal = () => {
      modal.classList.remove("is-open");
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => {
        modal.hidden = true;
      }, 180);
      document.documentElement.classList.remove("support-modal-open");
      if (copyButton) {
        window.clearTimeout(copyResetTimer);
        copyButton.textContent = copyButton.dataset.copyLabel ?? copyButton.textContent;
      }
      trigger.focus();
    };

    const openModal = () => {
      window.clearTimeout(closeTimer);
      if (copyButton) {
        window.clearTimeout(copyResetTimer);
        copyButton.textContent = copyButton.dataset.copyLabel ?? copyButton.textContent;
      }
      modal.hidden = false;
      document.documentElement.classList.add("support-modal-open");
      window.requestAnimationFrame(() => {
        modal.classList.add("is-open");
        const firstFocusable = getFocusable()[0];
        (firstFocusable ?? panel).focus();
      });
    };

    trigger.addEventListener("click", openModal);

    modal.querySelectorAll<HTMLElement>("[data-support-close]").forEach((closeControl) => {
      closeControl.addEventListener("click", closeModal);
    });

    modal.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        closeModal();
        return;
      }

      if (event.key !== "Tab") return;

      const focusable = getFocusable();
      if (focusable.length === 0) {
        event.preventDefault();
        panel.focus();
        return;
      }

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    copyButton?.addEventListener("click", async () => {
      const value = copyButton.dataset.copyValue ?? "";
      const copyLabel = copyButton.dataset.copyLabel ?? copyButton.textContent ?? "";
      const copiedLabel = copyButton.dataset.copiedLabel ?? copyLabel;

      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(value);
        } else {
          const input = document.createElement("textarea");
          input.value = value;
          input.setAttribute("readonly", "");
          input.style.position = "fixed";
          input.style.opacity = "0";
          document.body.append(input);
          input.select();
          document.execCommand("copy");
          input.remove();
        }

        copyButton.textContent = copiedLabel;
        window.clearTimeout(copyResetTimer);
        copyResetTimer = window.setTimeout(() => {
          copyButton.textContent = copyLabel;
        }, 2000);
      } catch {
        copyButton.textContent = copyLabel;
      }
    });
  });
</script>
