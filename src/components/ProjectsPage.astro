---
import Footer from "./Footer.astro";
import Icon from "./Icon.astro";
import Navbar from "./Navbar.astro";
import { projects } from "../data/projects";
import { localizedPath, pageText, siteText, type Locale } from "../data/site";
import Layout from "../layouts/Layout.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = siteText[locale];
const page = pageText[locale];
const title = `${page.projects.eyebrow} - ${copy.metaTitle}`;
---

<Layout locale={locale} lang={copy.langAttr} title={title} description={page.projects.description}>
  <Navbar {...copy.nav} locale={locale} coffeeSupport={copy.hero.coffeeSupport} />
  <main id="top" class="min-h-screen bg-paper pt-24">
    <section class="mx-auto max-w-site px-5 pb-12 pt-8 lg:px-8">
      <a href={localizedPath(locale)} class="inline-flex items-center gap-2 text-sm font-semibold text-muted transition hover:text-ink">
        <Icon name="arrow-down" class="h-4 w-4 rotate-90" />
        {page.backHome}
      </a>
      <p class="mono-label mt-10 text-xs font-semibold uppercase text-accent">{page.projects.eyebrow}</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold leading-tight text-ink sm:text-6xl">{page.projects.title}</h1>
      <p class="mt-5 max-w-2xl text-base leading-7 text-muted sm:text-lg">{page.projects.description}</p>
    </section>

    <section class="mx-auto grid max-w-site gap-5 px-5 pb-16 lg:px-8">
      {projects[locale].map((project) => (
        <article class="surface-card grid overflow-hidden rounded-lg border border-black/10 bg-white lg:grid-cols-[320px_minmax(0,1fr)]">
          <div class="project-visual-frame relative min-h-[220px] border-b border-black/10 p-4 lg:border-b-0 lg:border-r">
            <img src={project.image} alt={project.imageAlt} class="relative z-10 h-full w-full rounded-md bg-white/70 object-contain shadow-[0_12px_30px_rgba(0,0,0,0.12)] ring-1 ring-black/10" loading="lazy" />
          </div>
          <div class="grid gap-5 p-5 lg:grid-cols-[minmax(0,1fr)_260px] lg:p-6">
            <div>
              <p class="mono-label text-[0.68rem] font-semibold uppercase text-accent">{project.category}</p>
              <h2 class="mt-3 text-2xl font-semibold text-ink">{project.title}</h2>
              <p class="mt-3 text-sm leading-6 text-muted">{project.description}</p>
              <div class="mt-5 rounded-lg border border-black/10 bg-paper p-4">
                <p class="text-xs font-semibold uppercase text-ink">{page.projects.problem}</p>
                <p class="mt-2 text-sm leading-6 text-muted">{project.problem}</p>
              </div>
              <div class="mt-5 flex flex-wrap gap-2">
                {project.stack.map((item) => (
                  <span class="rounded-md bg-black/[0.04] px-2.5 py-1.5 text-xs font-semibold text-muted">{item}</span>
                ))}
              </div>
            </div>
            <aside class="rounded-lg border border-black/10 p-4">
              <p class="text-xs font-semibold uppercase text-ink">{page.projects.metrics}</p>
              <ul class="mt-3 space-y-3">
                {project.metrics.map((metric) => (
                  <li class="flex gap-2 text-sm leading-5 text-muted">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>
                    <span>{metric}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-5 flex flex-wrap gap-2">
                <a href={project.href} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-ink px-3 py-2 text-sm font-semibold text-white">
                  {page.openRepo}
                  <Icon name="arrow-up-right" class="h-4 w-4" />
                </a>
                {project.liveHref && (
                  <a href={project.liveHref} target="_blank" rel="noreferrer" class="inline-flex items-center gap-2 rounded-lg border border-black/10 px-3 py-2 text-sm font-semibold text-ink">
                    {page.openLive}
                    <Icon name="arrow-up-right" class="h-4 w-4" />
                  </a>
                )}
              </div>
            </aside>
          </div>
        </article>
      ))}
    </section>
  </main>
  <Footer {...copy.footer} locale={locale} coffeeSupport={copy.hero.coffeeSupport} />
</Layout>
