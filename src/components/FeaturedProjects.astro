---
import CurrentlyCard from "./CurrentlyCard.astro";
import Icon from "./Icon.astro";
import SectionHeader from "./SectionHeader.astro";
import type { CurrentItem } from "../data/current";
import type { Project } from "../data/projects";

interface Props {
  eyebrow: string;
  viewAll: string;
  viewAllHref: string;
  projects: Project[];
  currentEyebrow: string;
  currentViewMore: string;
  currentViewMoreHref: string;
  currentItems: CurrentItem[];
}

const { eyebrow, viewAll, viewAllHref, projects, currentEyebrow, currentViewMore, currentViewMoreHref, currentItems } = Astro.props;
---

<section id="projects" class="flex items-center bg-white py-12 sm:py-16">
  <span id="work" class="sr-only" aria-hidden="true"></span>
  <div class="mx-auto grid w-full max-w-[1400px] gap-8 px-5 lg:grid-cols-[minmax(0,1fr)_300px] lg:px-8">
    <div>
      <SectionHeader eyebrow={eyebrow} action={viewAll} href={viewAllHref} />

      <div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
        {projects.map((project) => (
          <a
            href={project.href}
            target={project.href.startsWith("http") ? "_blank" : undefined}
            rel={project.href.startsWith("http") ? "noreferrer" : undefined}
            class="surface-card group overflow-hidden rounded-lg border border-black/10 bg-white/95 transition duration-300 hover:-translate-y-1.5 hover:border-black/20 hover:shadow-soft"
          >
            <div class="project-visual-frame relative aspect-[16/10] overflow-hidden border-b border-black/10 p-2.5 sm:h-52 sm:p-3">
              <img
                src={project.image}
                alt={project.imageAlt}
                width="560"
                height="360"
                loading="lazy"
                class="relative z-10 h-full w-full rounded-md bg-white/70 object-contain shadow-[0_12px_30px_rgba(0,0,0,0.12)] ring-1 ring-black/10 transition duration-500 group-hover:scale-[1.02]"
              />
            </div>
            <div class="flex min-h-0 flex-col p-4 sm:min-h-[210px]">
              <p class="mono-label text-[0.68rem] font-semibold uppercase text-accent">
                {project.category}
              </p>
              <h3 class="mt-2 text-lg font-semibold leading-6 text-ink">{project.title}</h3>
              <p class="mt-3 text-sm leading-6 text-muted">{project.description}</p>
              <div class="mt-4 flex flex-wrap gap-1.5" aria-label={`${project.title} stack`}>
                {project.stack.slice(0, 4).map((item) => (
                  <span class="rounded-md bg-black/[0.04] px-2 py-1 text-[0.68rem] font-semibold text-muted">{item}</span>
                ))}
              </div>
              <span class="mt-auto inline-flex items-center justify-end gap-2 pt-5 text-sm font-semibold text-ink">
                {project.cta}
                <Icon name="arrow-up-right" class="h-4 w-4 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>

    <CurrentlyCard eyebrow={currentEyebrow} viewMore={currentViewMore} viewMoreHref={currentViewMoreHref} items={currentItems} />
  </div>
</section>
